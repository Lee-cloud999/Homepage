rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ggiyoo@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /posts/{postId} {
      // 공개된 글은 누구나 읽고, 대기 중인 글은 관리자만 읽어요.
      allow read: if resource.data.status == 'approved' || isAdmin();
      // 방문자는 '대기' 상태의 글만 쓸 수 있고, 길이 제한이 있어요.
      allow create: if request.resource.data.keys().hasOnly(['nickname', 'message', 'createdAt', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      // 승인(수정)과 삭제는 관리자만 할 수 있어요.
      allow update, delete: if isAdmin();
    }
  }
}
